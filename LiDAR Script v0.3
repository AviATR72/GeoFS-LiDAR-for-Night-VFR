      <input id="nvfr-samples" type="range"
        min="5000" max="40000" step="1000" value="18000"
        style="width:100%;margin:0 0 10px;accent-color:#25eaff;cursor:pointer">

      <label for="nvfr-radius" style="
        display:flex;justify-content:space-between;
