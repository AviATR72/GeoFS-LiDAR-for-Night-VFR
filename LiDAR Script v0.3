    </div>

    <div style="
      margin-top:10px;padding-top:8px;
      border-top:1px solid #16394b;
      color:#8ac9d5;line-height:1.8">
      <div style="font-weight:bold;margin-bottom:5px">
        ELEVATION COLOUR SCALE
      </div>
      <div style="display:flex;align-items:center;gap:7px">
        <span style="color:#1678ff">●</span> 0 ft - Blue
      </div>
      <div style="display:flex;align-items:center;gap:7px">
        <span style="color:#32ff85">●</span> 5,000 ft - Green
      </div>
      <div style="display:flex;align-items:center;gap:7px">
        <span style="color:#ffe34a">●</span> 8,000 ft - Yellow
      </div>
      <div style="display:flex;align-items:center;gap:7px">
        <span style="color:#ff842b">●</span> 12,000 ft - Orange
      </div>
      <div style="display:flex;align-items:center;gap:7px">
        <span style="color:#f22030">●</span> 17,000 ft - Red
      </div>
      <div style="display:flex;align-items:center;gap:7px">
        <span style="color:#790019">●</span> 20,000+ ft - Deep red
      </div>
    </div>
  `;

  document.body.appendChild(panel);
  state.panel = panel;

  const button = panel.querySelector("#nvfr-toggle");
  const modeOnButton = panel.querySelector("#nvfr-mode-on");
  const modeOffButton = panel.querySelector("#nvfr-mode-off");
  const modeAutoButton = panel.querySelector("#nvfr-mode-auto");
  const oceanButton = panel.querySelector("#nvfr-ocean-toggle");
  const status = panel.querySelector("#nvfr-status");
  const closeButton = panel.querySelector("#nvfr-close");

  // Added slider elements.
  const samplesSlider = panel.querySelector("#nvfr-samples");
  const radiusSlider = panel.querySelector("#nvfr-radius");
  const samplesValue = panel.querySelector("#nvfr-samples-value");
  const radiusValue = panel.querySelector("#nvfr-radius-value");
  const infoSamples = panel.querySelector("#nvfr-info-samples");
  const infoRadius = panel.querySelector("#nvfr-info-radius");

  function updateScanSettingsDisplay() {
    samplesValue.textContent = TOTAL_SAMPLES.toLocaleString();
    radiusValue.textContent = `${SCAN_RADIUS_METERS / 1000} km`;
    infoSamples.textContent = TOTAL_SAMPLES.toLocaleString();
    infoRadius.textContent = `${SCAN_RADIUS_METERS / 1000} km`;
  }

  function applyScanSettings() {
    TOTAL_SAMPLES = Number(samplesSlider.value);
    SCAN_RADIUS_METERS = Number(radiusSlider.value);
    updateScanSettingsDisplay();

    // Make the next refresh use the new settings.
    state.lastPosition = null;

    // If a scan is currently running, invalidate it. Its cleanup will
    // release the scanning lock; the regular refresh timer then starts
    // a fresh scan using the updated slider values.
    if (state.scanning) {
      state.scanId++;
    } else if (state.enabled) {
      refresh(true);
    }

    scene.requestRender();
  }

  samplesSlider.addEventListener("input", applyScanSettings);
  radiusSlider.addEventListener("input", applyScanSettings);
  updateScanSettingsDisplay();

  function showPanel() {
    panel.style.display = "block";
    launcher.style.display = "none";
  }

  function hidePanel() {
    panel.style.display = "none";
    launcher.style.display = "block";
  }

  launcher.addEventListener("click", showPanel);
  closeButton.addEventListener("click", hidePanel);

  function setStatus(message) {
    status.textContent = message;
  }

  function updateModeButtons() {
    const buttons = [
      [modeOnButton, "on"],
      [modeOffButton, "off"],
      [modeAutoButton, "auto"]
    ];

    for (const [modeButton, mode] of buttons) {
      const selected = state.lidarMode === mode;
      modeButton.style.background = selected ? "#173b4a" : "#101d35";
      modeButton.style.color = selected ? "#ffffff" : "#72f7ff";
      modeButton.style.borderColor = selected ? "#ffffff" : "#25eaff";
      modeButton.style.boxShadow = selected ? "0 0 8px #25eaff55" : "none";
    }
  }

  // Calculate the Sun's apparent altitude using GeoFS simulation time
  // and the aircraft's current latitude/longitude.
  function getSolarAltitudeDegrees(position) {
    try {
      const simulationDate = C.JulianDate.toDate(viewer.clock.currentTime);
      if (!(simulationDate instanceof Date) || !Number.isFinite(simulationDate.getTime())) {
        return null;
      }

      const rad = Math.PI / 180;
      const day = Math.floor(
        (Date.UTC(simulationDate.getUTCFullYear(), simulationDate.getUTCMonth(), simulationDate.getUTCDate()) -
         Date.UTC(simulationDate.getUTCFullYear(), 0, 0)) / 86400000
      );

      const hour =
        simulationDate.getUTCHours() +
        simulationDate.getUTCMinutes() / 60 +
        simulationDate.getUTCSeconds() / 3600;

      const gamma = 2 * Math.PI / 365 *
        (day - 1 + (hour - 12) / 24);

      const equationOfTime = 229.18 * (
        0.000075 +
        0.001868 * Math.cos(gamma) -
        0.032077 * Math.sin(gamma) -
        0.014615 * Math.cos(2 * gamma) -
        0.040849 * Math.sin(2 * gamma)
      );

      const declination =
        0.006918 -
        0.399912 * Math.cos(gamma) +
        0.070257 * Math.sin(gamma) -
        0.006758 * Math.cos(2 * gamma) +
        0.000907 * Math.sin(2 * gamma) -
        0.002697 * Math.cos(3 * gamma) +
        0.00148 * Math.sin(3 * gamma);

      const trueSolarMinutes =
        (hour * 60 + equationOfTime + 4 * position.lon + 1440) % 1440;

      let hourAngle = trueSolarMinutes / 4 - 180;
      if (hourAngle < -180) hourAngle += 360;

      const latitude = position.lat * rad;
      const declinationRad = declination;
      const hourAngleRad = hourAngle * rad;

      const sineAltitude =
        Math.sin(latitude) * Math.sin(declinationRad) +
        Math.cos(latitude) * Math.cos(declinationRad) *
        Math.cos(hourAngleRad);

      return Math.asin(Math.max(-1, Math.min(1, sineAltitude))) / rad;
    } catch (error) {
      console.warn("[Night VFR] Could not calculate solar altitude:", error);
      return null;
    }
  }

  function isNightAtAircraft() {
    const position = getAircraftPosition();
    if (!position) return null;

    const solarAltitude = getSolarAltitudeDegrees(position);
    if (!Number.isFinite(solarAltitude)) return null;

    // Civil night begins when the Sun is 6 degrees below the horizon.
    return solarAltitude <= -6;
  }

  function applyAutomaticMode() {
    if (state.destroyed || state.lidarMode !== "auto") return;

    const night = isNightAtAircraft();

    if (night === null) {
      setStatus("AUTO MODE | WAITING FOR SIMULATION TIME / AIRCRAFT");
      return;
    }

    if (night && !state.enabled) {
      enable();
      setStatus("AUTO MODE | NIGHT | LiDAR ACTIVE");
    } else if (!night && state.enabled) {
      disable();
      setStatus("AUTO MODE | DAYLIGHT | LiDAR STANDBY");
    } else {
      setStatus(night
        ? "AUTO MODE | NIGHT | LiDAR ACTIVE"
        : "AUTO MODE | DAYLIGHT | LiDAR STANDBY");
    }
  }

  function setLidarMode(mode) {
    if (!["on", "off", "auto"].includes(mode) || state.destroyed) return;

    state.lidarMode = mode;
    updateModeButtons();

    if (state.autoTimer) {
      clearInterval(state.autoTimer);
      state.autoTimer = null;
    }

    if (mode === "on") {
      enable();
      setStatus("MANUAL MODE | LiDAR FORCED ON");
    } else if (mode === "off") {
      disable();
      setStatus("MANUAL MODE | LiDAR FORCED OFF");
    } else {
      applyAutomaticMode();
      state.autoTimer = setInterval(applyAutomaticMode, 5000);
    }

    scene.requestRender();
  }

  function updateOceanButton() {
    oceanButton.textContent =
      `OCEAN POINTS: ${state.oceanPointsEnabled ? "ON" : "OFF"}`;
    oceanButton.style.color = state.oceanPointsEnabled ? "#72f7ff" : "#a0a0a0";
    oceanButton.style.borderColor = state.oceanPointsEnabled ? "#25eaff" : "#666";
  }

  oceanButton.addEventListener("click", () => {
    state.oceanPointsEnabled = !state.oceanPointsEnabled;
    state.oceanPoints.show = state.enabled && state.oceanPointsEnabled;
    updateOceanButton();
    scene.requestRender();
  });

  updateOceanButton();

  modeOnButton.addEventListener("click", () => setLidarMode("on"));
  modeOffButton.addEventListener("click", () => setLidarMode("off"));
  modeAutoButton.addEventListener("click", () => setLidarMode("auto"));
  updateModeButtons();

  // --------------------------------------------------
  // AIRCRAFT POSITION AND DISTANCE
  // --------------------------------------------------

  function getAircraftPosition() {
    const lla = G.aircraft?.instance?.llaLocation;

    if (!lla ||
        !Number.isFinite(lla[0]) ||
        !Number.isFinite(lla[1])) {
      return null;
    }

    return { lat: lla[0], lon: lla[1] };
  }

  function distanceMeters(a, b) {
    const R = 6371000;
    const rad = Math.PI / 180;

    const dLat = (b.lat - a.lat) * rad;
    const dLon = (b.lon - a.lon) * rad;

    const h =
      Math.sin(dLat / 2) ** 2 +
      Math.cos(a.lat * rad) *
      Math.cos(b.lat * rad) *
      Math.sin(dLon / 2) ** 2;

    return 2 * R * Math.asin(
      Math.sqrt(Math.min(1, h))
    );
  }

  // --------------------------------------------------
  // TERRAIN ELEVATION FALLBACK
  // --------------------------------------------------

  function readGroundAltitude(result) {
    if (Number.isFinite(result)) return result;

    if (Array.isArray(result)) {
      if (Number.isFinite(result[2])) return result[2];
      if (Number.isFinite(result[0])) return result[0];
    }

    if (result && typeof result === "object") {
      if (Number.isFinite(result.altitude)) return result.altitude;
      if (Number.isFinite(result.elevation)) return result.elevation;
      if (Number.isFinite(result.height)) return result.height;

      if (Array.isArray(result.location) &&
          Number.isFinite(result.location[2])) {
        return result.location[2];
      }
    }

    return null;
  }

  function getFallbackElevation(lat, lon) {
    try {
      return readGroundAltitude(
        G.getGroundAltitude([lat, lon])
      );
    } catch (_) {
      return null;
    }
  }

  // --------------------------------------------------
  // SMOOTH ELEVATION COLOUR GRADIENT
  //
  // Terrain heights are expected in metres.
  // Colour stops are specified in feet.
  // --------------------------------------------------

  function getElevationColor(terrainHeightMeters) {
    const altitudeFt = terrainHeightMeters * 3.280839895;

    const stops = [
      { ft:     0, r: 0.04, g: 0.35, b: 1.00 },
      { ft:  2500, r: 0.02, g: 0.72, b: 0.75 },
      { ft:  5000, r: 0.04, g: 1.00, b: 0.52 },
      { ft:  8000, r: 1.00, g: 0.90, b: 0.16 },
      { ft: 12000, r: 1.00, g: 0.43, b: 0.08 },
      { ft: 17000, r: 0.95, g: 0.08, b: 0.12 },
      { ft: 20000, r: 0.42, g: 0.00, b: 0.055 }
    ];

    // Clamp elevations below sea level to the blue endpoint.
    if (altitudeFt <= stops[0].ft) {
      const s = stops[0];

      return new C.Color(
        s.r, s.g, s.b, POINT_ALPHA
      );
    }

    const last = stops[stops.length - 1];

    // All terrain above 20,000 ft uses deep red.
    if (altitudeFt >= last.ft) {
      return new C.Color(
        last.r, last.g, last.b, POINT_ALPHA
      );
    }

    // Interpolate smoothly between adjacent elevation stops.
    for (let i = 0; i < stops.length - 1; i++) {
      const a = stops[i];
      const b = stops[i + 1];

      if (altitudeFt >= a.ft && altitudeFt <= b.ft) {
        const t = (altitudeFt - a.ft) / (b.ft - a.ft);

        // Smoothstep eases transitions to avoid hard colour bands.
        const smoothT = t * t * (3 - 2 * t);

        return new C.Color(
          a.r + (b.r - a.r) * smoothT,
          a.g + (b.g - a.g) * smoothT,
          a.b + (b.b - a.b) * smoothT,
          POINT_ALPHA
        );
      }
    }

    return new C.Color(
      last.r, last.g, last.b, POINT_ALPHA
    );
  }

  // --------------------------------------------------
  // BUILD RANDOMIZED AIRCRAFT-CENTRED SAMPLES
  // --------------------------------------------------

  function buildAircraftSamples(pos) {
    const samples = [];
    const latRad = pos.lat * Math.PI / 180;

    const latRadius = SCAN_RADIUS_METERS / 110540;

    const lonRadius =
      SCAN_RADIUS_METERS /
      (111320 * Math.max(
        0.15,
        Math.abs(Math.cos(latRad))
      ));

    for (let i = 0; i < TOTAL_SAMPLES; i++) {
      // Square-root distribution avoids clustering at the centre.
      const distance =
        Math.sqrt(Math.random()) * SCAN_RADIUS_METERS;

      const angle = Math.random() * Math.PI * 2;

      const north = Math.cos(angle) * distance;
      const east = Math.sin(angle) * distance;

      const lat =
        pos.lat + (north / SCAN_RADIUS_METERS) * latRadius;

      const lon =
        pos.lon + (east / SCAN_RADIUS_METERS) * lonRadius;

      samples.push({
        lat,
        lon,
        cartographic: C.Cartographic.fromDegrees(lon, lat)
      });
    }

    return samples;
  }

  // --------------------------------------------------
  // DRAW NEON TERRAIN POINTS
  //
  // A larger translucent point sits behind each bright
  // core point, producing a subtle neon appearance.
  // Both use the same elevation-derived colour.
  // --------------------------------------------------

  function drawPoint(sample, terrainHeight) {
    if (!Number.isFinite(terrainHeight)) return false;

    // GeoFS/Cesium commonly reports ocean surface elevation as ~0 m.
    // Keep near-zero elevation returns in a separate collection so they
    // can be hidden without affecting the rest of the terrain point cloud.
    const isOcean = terrainHeight <= 0.5;
    const targetPoints = isOcean ? state.oceanPoints : state.points;

    const position = C.Cartesian3.fromDegrees(
      sample.lon,
      sample.lat,
      terrainHeight + POINT_HEIGHT_OFFSET
    );

    const coreColor = getElevationColor(terrainHeight);

    const haloColor = new C.Color(
      coreColor.red,
      coreColor.green,
      coreColor.blue,
      HALO_ALPHA
    );

    // Outer neon halo.
    targetPoints.add({
      position,
      pixelSize: HALO_SIZE,
      color: haloColor,
      outlineWidth: 0,
      disableDepthTestDistance: 0
    });

    // Bright, sharply defined LiDAR dot.
    targetPoints.add({
      position,
      pixelSize: POINT_SIZE,
      color: coreColor,
      outlineWidth: 0,
      disableDepthTestDistance: 0
    });

    return true;
  }

  // --------------------------------------------------
  // TERRAIN SAMPLING
  // --------------------------------------------------

  async function sampleTerrainBatch(batch) {
    let heights = new Array(batch.length).fill(null);

    // Prefer Cesium's actual terrain elevations.
    try {
      if (typeof C.sampleTerrainMostDetailed === "function" &&
          globe.terrainProvider) {

        let timeoutId;

        const timeoutPromise = new Promise(resolve => {
          timeoutId = setTimeout(
            () => resolve(null),
            TERRAIN_TIMEOUT_MS
          );
        });

        try {
          const results = await Promise.race([
            C.sampleTerrainMostDetailed(
              globe.terrainProvider,
              batch.map(sample => sample.cartographic)
            ),
            timeoutPromise
          ]);

          if (results) {
            heights = results.map(result =>
              Number.isFinite(result.height)
                ? result.height
                : null
            );
          } else {
            console.warn(
              "[Night VFR] Terrain batch timed out; using GeoFS fallback."
            );
          }
        } finally {
          clearTimeout(timeoutId);
        }
      }
    } catch (error) {
      console.warn(
        "[Night VFR] Cesium terrain sampling failed:",
        error
      );
    }

    // Fill missing heights using GeoFS.
    for (let i = 0; i < batch.length; i++) {
      if (Number.isFinite(heights[i])) continue;

      heights[i] = getFallbackElevation(
        batch[i].lat,
        batch[i].lon
      );
    }

    return heights;
  }

  // --------------------------------------------------
  // SCAN AND REFRESH
  // --------------------------------------------------

  async function refresh(force = false) {
    if (!state.enabled || state.destroyed || state.scanning) {
      return;
    }

    const pos = getAircraftPosition();

    if (!pos) {
      setStatus("WAITING FOR AIRCRAFT...");
      return;
    }

    if (!force && state.lastPosition &&
        distanceMeters(state.lastPosition, pos) <
          MOVE_THRESHOLD_METERS) {
      return;
    }

    state.lastPosition = { ...pos };
    state.scanning = true;

    const scanId = ++state.scanId;
    const samples = buildAircraftSamples(pos);

    // Rebuild the point cloud for this scan.
    state.points.removeAll();
    state.oceanPoints.removeAll();

    setStatus(`SCANNING TERRAIN | 0/${samples.length}`);

    let count = 0;
    let completed = 0;

    try {
      for (let start = 0;
           start < samples.length;
           start += SCAN_BATCH_SIZE) {

        if (!state.enabled || state.destroyed ||
            scanId !== state.scanId) {
          return;
        }

        const batch = samples.slice(
          start,
          start + SCAN_BATCH_SIZE
        );

        const heights = await sampleTerrainBatch(batch);

        if (!state.enabled || state.destroyed ||
            scanId !== state.scanId) {
          return;
        }

        for (let i = 0; i < batch.length; i++) {
          if (drawPoint(batch[i], heights[i])) {
            count++;
          }
        }

        completed += batch.length;

        setStatus(
          `SCANNING | completed/{samples.length} SAMPLES | ${count} POINTS`
        );

        scene.requestRender();

        // Yield between batches to keep GeoFS responsive.
        await new Promise(resolve => setTimeout(resolve, 0));
      }

      setStatus(
        count > 0
          ? `SCAN COMPLETE | ${count} TERRAIN POINTS`
          : "NO ELEVATIONS — CHECK CONSOLE"
      );

      console.log(
        `[Night VFR] Neon scan finished: count/{samples.length} terrain points.`
      );
    } catch (error) {
      console.error("[Night VFR] Scan error:", error);
      setStatus("SCAN ERROR — CHECK CONSOLE");
    } finally {
      state.scanning = false;
      scene.requestRender();
    }
  }

  // --------------------------------------------------
  // ENABLE / DISABLE
  // --------------------------------------------------

  function enable() {
    if (state.enabled || state.destroyed) return;

    state.enabled = true;
    state.points.show = true;
    state.oceanPoints.show = state.oceanPointsEnabled;
    state.lastPosition = null;

    button.textContent = "DISABLE LiDAR NEON";
    button.style.color = "#ff9da9";
    button.style.borderColor = "#ff405d";

    setStatus("INITIALIZING NEON TERRAIN SCAN...");

    refresh(true);

    state.timer = setInterval(
      () => refresh(false),
      SCAN_INTERVAL_MS
    );

    scene.requestRender();
  }

  function disable() {
    if (!state.enabled) return;

    state.enabled = false;
    state.scanId++;

    clearInterval(state.timer);
    state.timer = null;

    state.points.show = false;
    state.oceanPoints.show = false;
    state.points.removeAll();
    state.oceanPoints.removeAll();
    state.lastPosition = null;

    button.textContent = "ENABLE LiDAR NEON";
    button.style.color = "#72f7ff";
    button.style.borderColor = "#25eaff";

    setStatus("SYSTEM STANDBY");
    scene.requestRender();
  }

  button.addEventListener("click", () => {
    if (state.enabled) disable();
    else enable();
  });

  // --------------------------------------------------
  // PUBLIC CONTROLS AND CLEANUP
  // --------------------------------------------------

  state.enable = enable;
  state.disable = disable;
  state.toggle = () => state.enabled ? disable() : enable();
  state.setMode = setLidarMode;
  state.showPanel = showPanel;
  state.hidePanel = hidePanel;

  // Expose current scan settings for inspection / external control.
  state.getScanSettings = () => ({
    totalSamples: TOTAL_SAMPLES,
    radiusMeters: SCAN_RADIUS_METERS
  });

  state.destroy = () => {
    if (state.destroyed) return;

    disable();

    state.destroyed = true;
    state.scanId++;

    clearInterval(state.timer);
    state.timer = null;
    clearInterval(state.autoTimer);
    state.autoTimer = null;

    try {
      scene.primitives.remove(state.points);
    } catch (_) {}
    try {
      scene.primitives.remove(state.oceanPoints);
    } catch (_) {}

    panel.remove();
    launcher.remove();

    if (window.NightVFRLiDAR === state) {
      delete window.NightVFRLiDAR;
    }
  };

  window.NightVFRLiDAR = state;
  setLidarMode("auto");

  console.log(
    "[Night VFR] LiDAR NEON loaded. Adjustable 5,000–40,000 terrain samples and 5–50 km scan radius, smooth elevation gradient."
  );
})();
